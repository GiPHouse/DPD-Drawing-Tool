# ====== NOLAI - Infrastructure / Sprint 2 / Task: Gitignore Update ======
#
# WHAT CHANGED:
#   - Removed 'Caddyfile' and 'docker-compose.yml' from this list.
#     Both are now committed files in the repository. Previously they were
#     generated at runtime by setup_merged.sh and excluded from version control.
#   - Added '.env' to prevent real credentials from being committed.
#     Use .env.example (which IS committed) as the template.
#
# ====== end of changes by SE ======

# OS
.DS_Store

# Runtime secrets — NEVER commit the real .env file
# Use .env.example as the template (that file IS committed)
.env

# Docker runtime artefacts
caddy-root.crt       # Generated self-signed cert — install on client machine, do not commit
/nextcloud_data/     # Nextcloud file storage — managed by Docker volume, not git
/nextcloud_db/       # Legacy path from old setup (superseded by db_data Docker volume)
/caddy_data/         # Caddy TLS certificate store — managed by Docker volume, not git

# Node dependencies
node_modules/
tests/unit/node_modules/
tests/e2e/node_modules/

# Test coverage output
/coverage/
coverage/
tests/unit/coverage/
lcov.info

# Playwright output
tests/e2e/playwright-report/
tests/e2e/test-results/
