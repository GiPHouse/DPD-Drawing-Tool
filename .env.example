# ====== NOLAI - Infrastructure / Sprint 2 / Task: Environment Variables ======
#
# Template for all runtime configuration values used by docker-compose.yml
# and docker/Dockerfile (single-container image).
#
# HOW TO USE:
#   cp .env.example .env
#   bash start.sh           ← base stack (no auth)
#   bash start-auth.sh      ← full stack with goauthentik SSO
#
# The default values in this file are intentionally weak and safe to use
# for local development and testing. DO NOT use them in production.
#
# IMPORTANT:
#   - .env is listed in .gitignore and must NEVER be committed to the repository.
#   - This file (.env.example) IS committed. It contains only dev-safe defaults.
#
# ====== end of changes by SE ======


# -----------------------------------------------------------------------
# MariaDB
# Used by both the 'db' service in docker-compose.yml and the single-
# container image (docker/Dockerfile) to create the Nextcloud database.
# -----------------------------------------------------------------------

# Root password for the MariaDB server.
# Not used by the application directly — only needed for DBA-level access.
MYSQL_ROOT_PASSWORD=devroot

# Password for the Nextcloud database user.
MYSQL_PASSWORD=devpassword

# Name of the Nextcloud database. Can be left as 'nextcloud'.
MYSQL_DATABASE=nextcloud

# Username Nextcloud uses to connect to the database. Can be left as 'nextcloud'.
MYSQL_USER=nextcloud


# -----------------------------------------------------------------------
# Nextcloud
# These values are consumed by the official nextcloud:28-apache image to
# perform an automated first-boot installation. If you change them after
# the first boot, Nextcloud will already be installed and these vars are
# ignored — change settings via occ instead.
# -----------------------------------------------------------------------

# Nextcloud administrator account username.
NEXTCLOUD_ADMIN_USER=admin

# Nextcloud administrator account password.
NEXTCLOUD_ADMIN_PASSWORD=admin

# The hostname clients use to reach Nextcloud.
# In local development this is 'localhost'.
# In a client deployment set this to the server's real domain name,
# e.g. 'dpd.example.com'. This value is also used by Caddy to determine
# which TLS certificate to obtain (Let's Encrypt for real domains,
# self-signed for localhost).
NEXTCLOUD_TRUSTED_DOMAINS=localhost


# -----------------------------------------------------------------------
# Goauthentik OIDC integration — production (single-container image)
#
# The client already runs a Goauthentik instance. These three variables
# point Nextcloud at the client's existing Goauthentik server for SSO.
# The container does NOT run Goauthentik itself.
#
# Leave all three empty to skip OIDC setup (Nextcloud falls back to its
# built-in username/password login).
#
# For the LOCAL DEV auth stack (docker-compose.auth.yml), these values
# are populated automatically by start-auth.sh — you do not need to fill
# them in by hand. They are written back to .env after the OAuth2 provider
# is created in the local goauthentik instance.
# -----------------------------------------------------------------------

# Full OIDC discovery URL from your Goauthentik instance.
# Production example: https://auth.example.com/application/o/nextcloud/
# Dev stack:          set automatically by start-auth.sh
OIDC_PROVIDER_URL=

# Client ID registered in Goauthentik for this application.
# Dev stack: set automatically by start-auth.sh
OIDC_CLIENT_ID=

# Client secret registered in Goauthentik for this application.
# Dev stack: set automatically by start-auth.sh
OIDC_CLIENT_SECRET=


# -----------------------------------------------------------------------
# goauthentik dev stack (docker-compose.auth.yml only)
#
# These variables are only used when running the local auth stack with
# start-auth.sh. They are not needed for the production single-container
# image, which connects to the client's existing Goauthentik server.
# -----------------------------------------------------------------------

# PostgreSQL database for goauthentik (separate from Nextcloud's MariaDB).
# goauthentik requires PostgreSQL and does not support MariaDB.
PG_PASS=devpassword
PG_USER=authentik
PG_DB=authentik

# Secret key used by goauthentik to sign sessions and tokens.
# Must be at least 50 random characters. This default is safe for local dev only.
AUTHENTIK_SECRET_KEY=c065d7f9ed616f8f23b2a26e1511d8e013837f460a90eb7b1b33f6000133bea71d1fe42e2a67f798146d62f9231ae69a3564

# Password for the initial goauthentik admin account ('akadmin').
# Only takes effect on the very first start. Changing this after first
# boot has no effect — reset via the goauthentik UI instead.
AUTHENTIK_BOOTSTRAP_PASSWORD=admin

# Static API token used by start-auth.sh to create the OAuth2 provider
# and application without requiring a browser login. Can be any string,
# but treat it as a secret — it grants full API access to goauthentik.
# Only takes effect on the very first start (same as BOOTSTRAP_PASSWORD).
AUTHENTIK_BOOTSTRAP_TOKEN=devtoken
