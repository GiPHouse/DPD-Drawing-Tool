# ====== NOLAI - Infrastructure / Sprint 2 / Task: Environment Variables ======
#
# Template for all runtime configuration values used by docker-compose.yml
# and docker/Dockerfile (single-container image).
#
# HOW TO USE:
#   cp .env.example .env
#   # Edit .env and replace every placeholder value before running anything.
#
# IMPORTANT:
#   - .env is listed in .gitignore and must NEVER be committed to the repository.
#   - This file (.env.example) IS committed. It contains only placeholder values,
#     never real credentials.
#
# ====== end of changes by SE ======


# -----------------------------------------------------------------------
# MariaDB
# Used by both the 'db' service in docker-compose.yml and the single-
# container image (docker/Dockerfile) to create the Nextcloud database.
# -----------------------------------------------------------------------

# Root password for the MariaDB server.
# Not used by the application directly — only needed for DBA-level access.
MYSQL_ROOT_PASSWORD=change_me_root_password

# Password for the Nextcloud database user.
MYSQL_PASSWORD=change_me_nextcloud_db_password

# Name of the Nextcloud database. Can be left as 'nextcloud'.
MYSQL_DATABASE=nextcloud

# Username Nextcloud uses to connect to the database. Can be left as 'nextcloud'.
MYSQL_USER=nextcloud


# -----------------------------------------------------------------------
# Nextcloud
# These values are consumed by the official nextcloud:28-apache image to
# perform an automated first-boot installation. If you change them after
# the first boot, Nextcloud will already be installed and these vars are
# ignored — change settings via occ instead.
# -----------------------------------------------------------------------

# Nextcloud administrator account username.
NEXTCLOUD_ADMIN_USER=admin

# Nextcloud administrator account password. Use a strong password.
NEXTCLOUD_ADMIN_PASSWORD=change_me_admin_password

# The hostname clients use to reach Nextcloud.
# In local development this is 'localhost'.
# In a client deployment set this to the server's real domain name,
# e.g. 'dpd.example.com'. This value is also used by Caddy to determine
# which TLS certificate to obtain (Let's Encrypt for real domains,
# self-signed for localhost).
NEXTCLOUD_TRUSTED_DOMAINS=localhost


# -----------------------------------------------------------------------
# Goauthentik OIDC integration
#
# The client already runs a Goauthentik instance. These variables point
# Nextcloud at the client's existing Goauthentik server for SSO login.
# The container does NOT run Goauthentik itself.
#
# Leave all three commented out to skip OIDC setup entirely (Nextcloud
# will use its built-in username/password login).
#
# Once the other engineers implement the auth integration, they will:
#   1. Uncomment these three lines in .env.example
#   2. Populate real values in .env
#   3. Uncomment the matching lines in docker-compose.yml
# -----------------------------------------------------------------------

# Full OIDC discovery URL from your Goauthentik instance.
# Example: https://auth.example.com/application/o/nextcloud/
# OIDC_PROVIDER_URL=

# Client ID registered in Goauthentik for this application.
# OIDC_CLIENT_ID=

# Client secret registered in Goauthentik for this application.
# OIDC_CLIENT_SECRET=
